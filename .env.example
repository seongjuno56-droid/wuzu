# 앱(Expo) 환경 변수. 이 파일을 .env.local 로 복사해 값을 채운다 (.env.local 은 git 에 올리지 않는다)
# 두 값이 모두 있으면 실제 Supabase 로그인, 하나라도 비면 mock 으로 동작한다.
# 값은 Supabase Project Settings → API Keys 에서 복사 (Project URL, publishable/anon 키)
# service_role(secret) 키는 절대 넣지 않는다 — EXPO_PUBLIC_* 값은 앱 번들에 그대로 들어간다.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# R2 공개 주소 (https://pub-….r2.dev, 출시 때 자체 도메인). 비밀 값이 아니다. R2 키는 여기에 넣지 않는다
EXPO_PUBLIC_MEDIA_BASE_URL=
# 하객 웹 주소 (https://…, 끝 슬래시는 없어도 있어도 된다). 비밀 값이 아니다. Supabase 값이 있는 빌드에서 비우면 공유가 안내만 띄우고 막힌다
EXPO_PUBLIC_GUEST_WEB_URL=
